#compdef scripts
# shellcheck shell=bash
# shellcheck disable=all

_scripts() {
    local -a builtins scripts_list
    local name desc

    builtins=(
        'refresh:Ensure all scripts in directory are executable'
        'update:Update Script-Manager to latest version'
        'add:Copy and add an external script'
        'new:Create a new script template'
        'edit:Edit a script in editor'
        'path:Print absolute path of a script'
        'uninstall:Uninstall Script-Manager and shell completions'
        'help:Show usage instructions'
    )

    if (( CURRENT == 2 )); then
        while IFS=$'\t' read -r name desc; do
            if [[ -n "$name" ]]; then
                scripts_list+=("${name}:${desc}")
            fi
        done < <(scripts --list-completions-with-desc 2>/dev/null)

        # Custom scripts listed first, followed by command parameters
        _describe -t scripts 'custom script' scripts_list
        _describe -t builtins 'command' builtins
    elif (( CURRENT == 3 )); then
        case "${words[2]}" in
            edit|path|which)
                while IFS=$'\t' read -r name desc; do
                    if [[ -n "$name" ]]; then
                        scripts_list+=("${name}:${desc}")
                    fi
                done < <(scripts --list-completions-with-desc 2>/dev/null)
                _describe -t scripts 'script' scripts_list
                ;;
            add|*)
                _files
                ;;
        esac
    else
        _files
    fi
}

_scripts "$@"
